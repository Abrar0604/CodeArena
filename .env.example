# ========================================================
# Supabase Configuration (Free Tier at https://supabase.com)
# Project Settings -> API -> Project URL & API Keys
# ========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ========================================================
# Master Admin Security (Route & API RBAC Barrier)
# Enforces strict authentication for /admin/* and /api/admin/*
# ========================================================
ADMIN_SECRET_KEY=your-secure-master-key-here
ADMIN_EMAILS=master@yourdomain.com

# ========================================================
# Piston Code Execution Engine (100% Open Source Sandbox)
# Self-hosted Docker: http://localhost:2000/api/v2/execute
# Or hosted mirror: https://api.onlinecompiler.io/api/v2/piston/execute
# Or EMKC instance: https://emkc.org/api/v2/piston/execute
# ========================================================
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
# PISTON_API_KEY=your_optional_api_key_or_token
